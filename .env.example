# ==============================================
# 竞品分析 Agent - 环境变量配置
# 复制此文件为 .env 并填入真实值
# ==============================================

# === LLM API（OpenAI 兼容） ===
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# === Tavily 搜索引擎 ===
# 注册获取免费 API Key: https://app.tavily.com
# 免费额度: 1,000 次搜索/月
TAVILY_API_KEY=your_tavily_api_key

# === 知乎开放平台（zhihu.com） ===
# Access Secret 获取: https://developer.zhihu.com/profile
# 能力：全网搜索(global_search) / 知乎站内搜索(zhihu_search) / 知乎直答(zhida)
ZHIHU_API_KEY=your_zhihu_access_secret

# === 博查搜索引擎（Bocha Web Search API） ===
# API Key 获取与文档: https://bocha-ai.feishu.cn/wiki/RXEOw02rFiwzGSkd9mUcqoeAnNK
# 端点: POST https://api.bochaai.com/v1/web-search（Authorization: Bearer <key>）
BOCHA_API_KEY=your_bocha_api_key

# 服务端默认搜索回退: auto(bocha优先) / tavily / bocha / zhihu / zhihu_site / zhida
# 前端「来源」选择已移除「自动」，用户须直接选择具体来源，缺省 Tavily
SEARCH_PROVIDER=auto
FRONTEND_ORIGIN=http://<服务器IP>:8000

# === 版本号 ===
# 生产环境: vX.Y.Z（与 Git 标签一致）；测试/预发: vX.Y.Z-beta.N / vX.Y.Z-rc.N
APP_VERSION=v1.5.5

# === 环境 ===
# 显式指定环境: test（测试）/ staging（预发）/ prod（生产）
# 默认 auto：按 APP_VERSION 后缀推断（beta→test，rc/pre/dev→staging，其余→prod）
# 测试/预发环境版本号静态展示「XX 环境 vX.Y.Z-阶段标识.序号」（警示橙 #FF7D00），生产环境可点击查看更新日志
APP_ENV=auto
